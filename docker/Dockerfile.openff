FROM mambaorg/micromamba:1.5
COPY envs/atomipy-openff.yml /tmp/env.yml
RUN micromamba install -f /tmp/env.yml -n base --yes && \
    micromamba clean --all --yes
COPY workers/openff_worker /app
WORKDIR /app
ENV PYTHONPATH=/app
EXPOSE 8001
# Shell form so ${PORT} expands at runtime (Cloud Run injects $PORT, default 8080).
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8001}"]
