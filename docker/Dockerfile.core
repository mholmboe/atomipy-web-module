FROM mambaorg/micromamba:1.5
COPY envs/atomipy-core.yml /tmp/env.yml
RUN micromamba install -f /tmp/env.yml -n base --yes && \
    micromamba clean --all --yes
# GROMACS engine (CPU build) in its OWN env, not base — the conda gromacs GMXRC activation
# script aborts container startup on a bash-completion glob if base activates it. A separate
# env is never activated; just put `gmx` on PATH. See root Dockerfile for details.
RUN micromamba create -n gmx --yes -c conda-forge gromacs && \
    micromamba clean --all --yes
ENV PATH=$PATH:/opt/conda/envs/gmx/bin
COPY backend/core /app
COPY atomipy /app/atomipy
WORKDIR /app
ENV PYTHONPATH=/app
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
