# The project tracks Vite 8, but @vitejs/plugin-react-swc still declares its peer range
# only up to Vite 7. The plugin works fine with Vite 8 — this just stops npm's strict
# peer-dependency check from failing `npm ci` / `npm install` (and the installer build,
# Colab, and CI). Remove once the swc plugin publishes a Vite-8 peer range.
legacy-peer-deps=true
